# --- Database -----------------------------------------------------------
# When unset, RosterIQ runs on an embedded PGlite (Postgres) database stored
# in .data/pglite — zero-config local development.
# For production, point at a managed Postgres (e.g. Supabase):
# DATABASE_URL=postgres://user:password@host:5432/rosteriq

# --- Auth ---------------------------------------------------------------
# Auth provider: "local" (built-in credentials, default) or "supabase".
# AUTH_PROVIDER=local
# Secret used to sign session tokens. REQUIRED in production.
# Generate with: openssl rand -hex 32
# SESSION_SECRET=
# Who can create an account: "open" (default) or "invite_only" (only people
# holding an invite link an org admin created in Settings → Invite people).
# REGISTRATION_MODE=open

# --- Supabase (only when AUTH_PROVIDER=supabase) ------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- AI assistant (future; provider abstraction, OFF by default) --------
# LLM_PROVIDER=none
# LLM_API_KEY=

# --- Real-data connectors -------------------------------------------------
# NHL API and MoneyPuck need no key. EliteProspects (official API only) stays
# DISABLED until a key is configured here; the key is sent as the `apiKey`
# query parameter and redacted from every cached URL, provenance record, and log.
# EP_API_KEY=
# Behind an outbound HTTPS proxy, Node's built-in fetch needs this to use it:
# NODE_USE_ENV_PROXY=1

# --- Billing (Stripe) — OFF by default ---------------------------------------
# While off, every organization has every feature. Turn on only after the data
# sources are licensed for commercial use. Card data stays on stripe.com.
# BILLING_ENABLED=true
# APP_URL=https://your-domain.example
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...        (endpoint: <APP_URL>/api/billing/webhook)
# Price ids from the Stripe dashboard, one pair per plan you sell:
# STRIPE_PRICE_<PLAN>_MONTH / STRIPE_PRICE_<PLAN>_YEAR, PLAN one of FAN, PLAYER,
# COACH, SCOUT, MANAGER, YOUTH_TEAM, JUNIOR_CLUB, COLLEGE_PROGRAM (Pro club is quoted).
# Plans without price ids show as "not on sale yet". See src/lib/billing/plans.ts.
# STRIPE_PRICE_SCOUT_MONTH=price_...
# STRIPE_PRICE_SCOUT_YEAR=price_...
# Optional: extra seats on organization plans
# STRIPE_PRICE_EXTRA_SEAT=price_...
